# ── vLLM inference ───────────────────────────────────────────────
# Модель, обслуживаемая OpenAI-совместимым endpoint'ом vLLM.
# Для закрытых (gated) моделей (Llama-3, Gemma) требуется HF_TOKEN ниже.
# Открытые модели не требуют токена, например: Qwen/Qwen2.5-7B-Instruct
MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
# Токен Hugging Face: https://huggingface.co/settings/tokens
# Оставьте пустым, если используете открытую модель.
HF_TOKEN=

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=dataguru_admin
POSTGRES_DB=mas_knowledge_base
# Обязательный параметр. Создайте собственный пароль, например:
#   openssl rand -base64 24
POSTGRES_PASSWORD=
